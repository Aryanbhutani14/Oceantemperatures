data/*
!data/audit/
!data/README.md

# Model artifacts / experiment outputs (large)
/models/
experiments/*/model*
*.zarr/
*.nc
*.parquet

# Credentials
.env
*.netrc
.copernicusmarine/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Large regenerable prediction arrays (rebuilt by scripts/05_models.py)
results/**/*.npz

# Node build tools for the report/deck
reports/build/node_modules/

# Final report and presentation: kept local only, never pushed to GitHub
reports/*.pptx
reports/*.docx
reports/*.pdf
